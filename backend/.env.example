DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
TAVILY_API_KEY=replace-with-your-tavily-key
WEB_RESEARCH_ENABLED=false
RESEARCH_TOTAL_TIMEOUT_SECONDS=45
RESEARCH_TOOL_TIMEOUT_SECONDS=20
RESEARCH_MAX_TOOL_CALLS=4
RESEARCH_MAX_SEARCH_CALLS=2
RESEARCH_MAX_SEARCH_RESULTS=8
RESEARCH_MAX_EXTRACT_URLS=3
RESEARCH_MAX_EVIDENCE_CHARS=24000
RESEARCH_FULL_MATERIAL_MIN_CHARS=300
APP_ENV=development
CORS_ORIGINS=http://localhost:10086,http://127.0.0.1:10086
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=replace-with-your-mysql-user
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=AI-learn
WECHAT_APP_ID=replace-with-your-wechat-appid
WECHAT_APP_SECRET=replace-with-your-wechat-appsecret
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_HOURS=168
UPLOAD_BASE_URL=http://127.0.0.1:8000
DASHSCOPE_API_KEY=replace-with-your-bailian-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
KNOWLEDGE_UPLOAD_DIR=uploads/knowledge
CHROMA_PERSIST_DIR=data/chroma
KNOWLEDGE_BASE_LIMIT=5
KNOWLEDGE_DOCUMENT_LIMIT=20
KNOWLEDGE_FILE_MAX_BYTES=10485760
KNOWLEDGE_MAX_CHARS=2000000
KNOWLEDGE_MAX_CHUNKS=5000
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_RETRIEVAL_TOP_K=8
KNOWLEDGE_RETRIEVAL_MIN_SCORE=0.25
KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=4
KNOWLEDGE_RETRIEVAL_MIN_TOTAL_CHARS=80
# Optional: use an existing Apache Tika server for legacy .doc parsing.
TIKA_SERVER_ENDPOINT=
