DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
TAVILY_API_KEY=replace-with-your-tavily-key
WEB_RESEARCH_ENABLED=false
RESEARCH_TOTAL_TIMEOUT_SECONDS=45
RESEARCH_TOOL_TIMEOUT_SECONDS=20
RESEARCH_MAX_TOOL_CALLS=4
RESEARCH_MAX_SEARCH_CALLS=2
RESEARCH_MAX_SEARCH_RESULTS=8
RESEARCH_MAX_EXTRACT_URLS=3
RESEARCH_MAX_EVIDENCE_CHARS=24000
RESEARCH_FULL_MATERIAL_MIN_CHARS=300
APP_ENV=development
CORS_ORIGINS=http://localhost:10086,http://127.0.0.1:10086
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=replace-with-your-mysql-user
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=AI-learn
WECHAT_APP_ID=replace-with-your-wechat-appid
WECHAT_APP_SECRET=replace-with-your-wechat-appsecret
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_HOURS=168
UPLOAD_BASE_URL=http://127.0.0.1:8000
